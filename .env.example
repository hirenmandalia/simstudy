# --- Anthropic (required for the agent) -------------------------------------
# Get a key at https://platform.claude.com/ and paste it here.
# If your key is NOT scoped to a workspace (organization-level key), set the
# workspace ID (Console → Settings → Workspaces, starts with "wrkspc_"):
# ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=

# Models (all default to claude-opus-5-5). Persona/utility calls are the bulk
# of a run; set these to claude-sonnet-5-5 to cut cost if quality holds.
# MASTER_MODEL=claude-opus-5-5
# PERSONA_MODEL=claude-opus-5-5
# UTILITY_MODEL=claude-opus-5-5
# MASTER_EFFORT=medium        # low | medium | high
# PERSONA_EFFORT=low          # low | medium | high
# SYNTHESIS_EFFORT=high       # medium | high
# RUN_CONCURRENCY=3           # persona sessions run in parallel

# --- Auth.js -----------------------------------------------------------------
# Generate with: npx auth secret   (or any 32+ random bytes, base64)
AUTH_SECRET=

# Google OAuth client (Web application). Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# "Continue as Demo PM" is available in development when Google isn't
# configured. Force it on/off with:
# ENABLE_DEV_LOGIN=true

# --- Storage -----------------------------------------------------------------
# Local development stores projects in files under DATA_DIR. When hosted
# (Render or Vercel) the app uses Supabase: Postgres plus a private "screens"
# Storage bucket. It needs POSTGRES_URL (transaction pooler URI), SUPABASE_URL
# and SUPABASE_SECRET_KEY (or SUPABASE_SERVICE_ROLE_KEY).
# Force one or the other with STORE_BACKEND=file | supabase.
# DATA_DIR=./data
# STORE_BACKEND=file
#
# To work against Supabase locally, put those three settings in a separate,
# git-ignored .env.development.local (keeps this file intact; quote the URL),
# then apply the schema and check the store:
#   npm run db:migrate
#   npm run store:check:supabase
